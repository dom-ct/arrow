bazel_dep(name = "boringssl", version = "0.20260713.0")
bazel_dep(name = "brotli", version = "1.2.0.bcr.1")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "double-conversion", version = "3.3.1")
bazel_dep(name = "jemalloc", version = "5.3.0-bcr.alpha.5")
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")
bazel_dep(name = "mimalloc", version = "2.2.4.bcr.2")
bazel_dep(name = "rapidjson", version = "1.1.0.bcr.20250205")
bazel_dep(name = "simdjson", version = "4.6.0")
bazel_dep(name = "snappy", version = "1.2.2.bcr.3")
bazel_dep(name = "glog", version = "0.7.1.bcr.1")

