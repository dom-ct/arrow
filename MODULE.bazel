# MODULE.bazel
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

## Add explcit dependency to rules_cc for Bazel 9.1.0

git_repository(
    name = "xsimd",
    remote = "https://github.com/xtensor-stack/xsimd.git",
    commit = "eb34bc1fcdfae7efcac6476c52adaaba145f1f4b",
    build_file = "//bazel/build_files:xsimd.bazel",
)

git_repository(
    name = "arrow",
    remote = "https://github.com/apache/arrow.git",
    commit = "c44eca6892364e58489fe564f910c0e1c1c6cb6b",
    build_file = "//bazel/build_files:arrow.bazel",
)

git_repository(
    name = "thrift",
    remote = "https://github.com/apache/thrift.git",
    commit = "a42b18b9a93865ed796c4494133c77108fce98b4",
    build_file = "//bazel/build_files:thrift.bazel",
)

# double-conversion - latest version in main already has it but it's not in BCR yet

archive_override(
    module_name = "double-conversion",
    urls = ["https://github.com/google/double-conversion/archive/refs/tags/v3.3.1.tar.gz"],
    strip_prefix = "double-conversion-3.3.1",
    patch_cmds = [
        "sed -i '1i\\load(\"@rules_cc//cc:defs.bzl\", \"cc_binary\", \"cc_library\", \"cc_test\")' BUILD",
        "sed -i '$a\\bazel_dep(name = \"rules_cc\", version = \"0.2.19\")' MODULE.bazel",
    ],
    integrity = "sha256-/lSQEFXHEwLc3Fw8y+JlpsGRl483Yc4UFNCJXWsOqQ4=",
)

single_version_override(
    module_name = "mimalloc",
    version = "2.2.4.bcr.2",
    patch_cmds = [
        "sed -i '/name = \"mimalloc-lib\"/a\\    visibility = [\"//visibility:public\"],' BUILD.bazel",
    ],
)

# snappy
single_version_override(
    module_name = "snappy",
    version = "1.2.2.bcr.3",
    patches = ["//bazel/patches:snappy_includes.patch"]
)


# gcc toolchain
gcc_toolchains = use_extension("@gcc_toolchain//toolchain:module_extensions.bzl", "gcc_toolchains", dev_dependency = True)

gcc_toolchains.toolchain(
    name = "gcc_toolchain_x86_64",
    target_arch = "x86_64",
    gcc_version = "12.5.0",
)
use_repo(gcc_toolchains, "gcc_toolchain_x86_64")

register_toolchains(
    "@gcc_toolchain_x86_64//:cc_toolchain",
    dev_dependency = True,
)
