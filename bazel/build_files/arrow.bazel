# Description:
#   Apache Arrow library
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache 2.0

exports_files(["LICENSE.txt"])

genrule(
    name = "arrow_util_config",
    srcs = ["cpp/src/arrow/util/config.h.cmake"],
    outs = ["cpp/src/arrow/util/config.h"],
    cmd = ("sed " +
           "-e 's/@ARROW_VERSION_MAJOR@/25/g' " +
           "-e 's/@ARROW_VERSION_MINOR@/0/g' " +
           "-e 's/@ARROW_VERSION_PATCH@/1/g' " +
           "-e 's/cmakedefine ARROW_USE_NATIVE_INT128/undef ARROW_USE_NATIVE_INT128/g' " +
           "-e 's/cmakedefine/define/g' " +
           "$< >$@"),
)

genrule(
    name = "arrow_util_config_internal",
    srcs = ["cpp/src/arrow/util/config_internal.h.cmake"],
    outs = ["cpp/src/arrow/util/config_internal.h"],
    cmd = "cp $< $@",
)

genrule(
    name = "parquet_version_h",
    srcs = ["cpp/src/parquet/parquet_version.h.in"],
    outs = ["cpp/src/parquet/parquet_version.h"],
    cmd = ("sed " +
           "-e 's/@PARQUET_VERSION_MAJOR@/25/g' " +
           "-e 's/@PARQUET_VERSION_MINOR@/0/g' " +
           "-e 's/@PARQUET_VERSION_PATCH@/0/g' " +
           "$< >$@"),
)

cc_library(
    name = "arrow",
    srcs = glob(
        [
            "cpp/src/arrow/*.cc",
            "cpp/src/arrow/array/*.cc",
            "cpp/src/arrow/csv/*.cc",
            "cpp/src/arrow/io/*.cc", 
            "cpp/src/arrow/ipc/*.cc",
            "cpp/src/arrow/json/*.cc",
            "cpp/src/arrow/tensor/*.cc",
            "cpp/src/arrow/util/*.cc",
            "cpp/src/arrow/**/*.h",
            "cpp/src/parquet/**/*.h",
            "cpp/src/parquet/**/*.cc",
            "cpp/src/generated/*.h",
            "cpp/src/generated/*.cpp",
            "cpp/src/generated/*.tcc",
            "cpp/thirdparty/flatbuffers/include/flatbuffers/*.h",
        ],
        exclude = [
            "cpp/src/**/*_benchmark.cc",
            "cpp/src/**/*_main.cc",
            "cpp/src/**/*_nossl.cc",
            "cpp/src/**/*_test.cc",
            "cpp/src/**/test_*.cc",
            "cpp/src/**/*hdfs*.cc",
            "cpp/src/**/*fuzz*.cc",
            "cpp/src/**/file_to_stream.cc",
            "cpp/src/**/stream_to_file.cc",
            "cpp/src/arrow/util/async_util.cc",
            "cpp/src/arrow/util/tracing_internal.cc",
            "cpp/src/arrow/memory_pool_jemalloc.cc",
            "cpp/src/arrow/util/bpacking_avx2.cc",
            "cpp/src/arrow/util/bpacking_avx512.cc",
            "cpp/src/parquet/bloom_filter_avx2.cc",
            "cpp/src/arrow/util/bpacking*",
            "cpp/src/arrow/util/byte_stream_split_internal_avx2.cc",
        ],
    ) + select({
        "@bazel_tools//src/conditions:windows": [
            "cpp/src/arrow/vendored/musl/strptime.c",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "cpp/src/arrow/util/config.h",
        "cpp/src/parquet/parquet_version.h",
        "cpp/src/arrow/util/config_internal.h",
    ] + glob(["cpp/src/arrow/**/*.h"]) + glob(["cpp/src/arrow/**/*.hpp"]),
    copts = select({
        "@bazel_tools//src/conditions:windows": [
            "/std:c++20",
        ],
        "//conditions:default": [
            "-std=c++20",
        ],
    }),
    includes = [
        "cpp/src",
        "cpp/thirdparty/flatbuffers/include",
    ],
    textual_hdrs = [
        "cpp/src/arrow/vendored/xxhash/xxhash.c",
    ],
    deps = [
        "@boost.multiprecision",
        "@boringssl//:crypto",
        "@brotli",
        "@bzip2",
        "@double-conversion",
        "@glog",
        "@lz4//:lz4_frame",
        "@mimalloc//:mimalloc",
        "@mimalloc//:mimalloc-api",
        "@opentelemetry-cpp//api",
        "@rapidjson",
        "@simdjson",
        "@snappy//:snappy",
        "@thrift",
        "@xsimd",
        "@zlib",
        "@zstd",
    ],
    linkopts = ["-lstdc++", "-lgcc_s", "-lgcc_eh"],
)
